<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head", {title: "Members Only - New Message"}) %>
    <%- include("./partials/header") %>
  <body>
      <div class="scroll">
        <div class="form-container">
          <form class="form-style" action="/new-message" method="POST" >
            <h1>New Message</h1>
            <div class="errors">
              <% if(locals.errors) {%>
                <ul>
                  <% errors.forEach((error) => {%>
                    <li class="error">
                      <%= error.msg%>
                    </li>
                    <% }) %>
                  </ul>
                  <% } %>
                </div>
                <div class="form-content">
                  <div class="form-left">
                    <label for="title">Title:</label>
                    <label for="message">Message:</label>
                  </div>
                  <div class="form-right">
                    <input type="text" name="title" maxlength="70" required/>
                    <textarea type="text" name="message" maxlength="250" required></textarea>
                  </div> 
                </div>
                <button class="form-btn" type="submit">Post Message</button>
              </form>
            </div> 
          </div>
        </body>
</html>
