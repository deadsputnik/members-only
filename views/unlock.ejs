<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head", {title: "Members Only - Unlock"}) %>
    <%- include("./partials/header") %>
  <body>
    <div class="scroll">
      <div class="form-container">
      <form class="form-style" action="/unlock" method="POST" >
        <h1>Unlock</h1>
        <% if (locals.message) {%>
          <% if (message === "SUCCESS") {%>
          <div style="color:green">SUCCESS</div>
          <% } else { %>
          <div style="color:red">Incorrect code</div>
<% } %>
            <% } %>
            <div class="form-content">
              <div class="form-left">
                <label for="username">Code:</label>
              </div>
              <div class="form-right">
                <input type="text" name="code" required>
              </div> 
            </div>
            <button class="form-btn" type="submit">Unlock</button>
            </form>
          </div>
        </div>

  </body>
</html>
