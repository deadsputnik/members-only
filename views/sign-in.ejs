<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head", {title: "Members Only - Log in"}) %>
    <%- include("./partials/header") %>
  <body>
    <div class="scroll">
      <div class="form-container">
      <form class="form-style" action="/sign-in" method="POST" >
        <h1>Sign In</h1>
        <% if (messages) {%>
          <ul>
            <% messages.forEach((message) => {%>
              <li class="error">
                <%= message %>
              </li>
              <% }) %>
            </ul>
            <% } %>
            <div class="form-content">
              <div class="form-left">
                <label for="username">Username:</label>
                <label for="password">Password:</label>
              </div>
              <div class="form-right">
                <input type="text" name="username" value="<%= locals.inputUsername && "" %>" required>
                <input type="password" name="password" required>
              </div> 
            </div>
            <button class="form-btn" type="submit">Sign In</button>
            </form>
          </div>
        </div>

  </body>
</html>
